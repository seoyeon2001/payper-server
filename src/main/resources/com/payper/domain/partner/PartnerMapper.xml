<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.payper.domain.partner.PartnerMapper">
    <select id="findAllByCategoryId" resultType="PartnerIdNameDto">
        SELECT *
        FROM partner
        WHERE category_id = #{categoryId}
          AND is_deleted = false;
    </select>
    <select id="findByPartnerName" resultType="PartnerIdNameDto">
        SELECT *
        FROM partner
        WHERE partner_name = #{partnerName}
          AND is_deleted = false;
    </select>

</mapper>