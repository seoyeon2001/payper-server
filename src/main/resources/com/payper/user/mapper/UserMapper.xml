<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.payper.user.mapper.UserMapper">

    <select id="get" resultType="com.payper.user.domain.User">
        select * from user where user_id=#{userId}
    </select>

    <update id="updateConnectedId">
        UPDATE user SET connected_id = #{connectedId} WHERE user_id = #{userId}
    </update>
</mapper>
